# Copy this file to .env and fill in real values. .env is gitignored
# and must never be committed.

# Local dev: `docker run --name dice-pg -e POSTGRES_PASSWORD=dev -p 5432:5432 -d postgres:17`
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Secret used to encrypt the iron-session cookie. Must be at least 32
# characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
